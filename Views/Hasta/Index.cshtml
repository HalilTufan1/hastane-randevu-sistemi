@model List<Randevu>
@{
    ViewData["Title"] = "Randevularım";
}

<h2>Randevularım</h2>
<a class="btn btn-primary mb-3" asp-action="RandevuAl">Yeni Randevu Al</a>

@if (Model.Count == 0)
{
    <p>Henüz randevunuz yok.</p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Saat</th>
                <th>Hizmet</th>
                <th>Doktor / Personel</th>
                <th>Şube</th>
                <th>Ücret</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Baslangic.ToString("dd.MM.yyyy")</td>
                    <td>@r.Baslangic.ToString("HH:mm") - @r.Bitis.ToString("HH:mm")</td>
                    <td>@r.Hizmet?.Ad</td>
                    <td>@r.Calisan?.GorunenAd</td>
                    <td>@r.Hizmet?.Bolum?.Sube?.Ad</td>
                    <td>@r.Ucret TL</td>
                    <td><span class="badge bg-@Yardimci.DurumRengi(r.Durum)">@r.DurumYazisi()</span></td>
                    <td>
                        @if (r.AktifMi() && r.Baslangic > DateTime.Now)
                        {
                            <form asp-action="Iptal" asp-route-id="@r.Id" method="post" onsubmit="return confirm('Randevu iptal edilsin mi?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">İptal</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
