@{
    ViewData["Title"] = "Giriş";
}

<div class="row">
    <div class="col-md-5">
        <h2>Giriş Yap</h2>

        @if (ViewBag.Hata != null)
        {
            <div class="alert alert-danger">@ViewBag.Hata</div>
        }

        <form asp-action="Giris" method="post">
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input name="kullaniciAdi" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input name="sifre" type="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Giriş</button>
        </form>

        <p class="mt-3">Hesabınız yok mu? <a asp-action="Kayit">Kayıt olun</a></p>
    </div>
</div>
