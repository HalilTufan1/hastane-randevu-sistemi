@model List<Calisan>
@{
    ViewData["Title"] = "Çalışanlar";
    var subeler = (List<Sube>)ViewBag.Subeler;
    var hizmetler = (List<Hizmet>)ViewBag.Hizmetler;
}

<h2>Çalışanlar</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Uzmanlık</th>
            <th>Şube</th>
            <th>Hizmetler</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.GorunenAd</td>
                <td>@c.Uzmanlik</td>
                <td>@c.Sube?.Ad</td>
                <td>@string.Join(", ", c.Hizmetler.Select(h => h.Ad))</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Uygunluk" asp-route-id="@c.Id">Çalışma Saatleri</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="CalisanDuzenle" asp-route-id="@c.Id">Düzenle</a>
                    <form asp-action="CalisanSil" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Çalışan ve randevuları silinecek. Emin misiniz?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<h4 class="mt-4">Çalışan Ekle</h4>
<form asp-action="CalisanEkle" method="post" class="col-md-8">
    <div class="row mb-2">
        <div class="col"><input name="ad" class="form-control" placeholder="Ad" required /></div>
        <div class="col"><input name="soyad" class="form-control" placeholder="Soyad" required /></div>
    </div>
    <div class="row mb-2">
        <div class="col"><input name="unvan" class="form-control" placeholder="Unvan (Dr., Hemşire, Laborant...)" /></div>
        <div class="col"><input name="uzmanlik" class="form-control" placeholder="Uzmanlık" /></div>
    </div>
    <div class="row mb-2">
        <div class="col"><input name="kullaniciAdi" class="form-control" placeholder="Kullanıcı adı" required /></div>
        <div class="col"><input name="sifre" type="password" class="form-control" placeholder="Şifre (en az 6 karakter)" required /></div>
    </div>
    <div class="mb-2">
        <label class="form-label">Şube</label>
        <select name="subeId" class="form-select">
            @foreach (var s in subeler)
            {
                <option value="@s.Id">@s.Kurum?.Ad - @s.Ad</option>
            }
        </select>
    </div>
    <div class="mb-2">
        <label class="form-label">Verdiği hizmetler (sadece seçilen şubedekiler kaydedilir)</label>
        @foreach (var h in hizmetler)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="hizmetIdleri" value="@h.Id" id="h@(h.Id)" />
                <label class="form-check-label" for="h@(h.Id)">@h.Bolum?.Sube?.Ad - @h.Bolum?.Ad - @h.Ad</label>
            </div>
        }
    </div>
    <button type="submit" class="btn btn-primary">Ekle</button>
</form>
