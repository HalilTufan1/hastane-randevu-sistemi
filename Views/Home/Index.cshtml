@model List<Kurum>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="p-4 mb-4 bg-light rounded">
    <h1>Hastane / Klinik Randevu Sistemi</h1>
    <p>Kurum, hizmet ve doktor seçerek kolayca randevu alabilirsiniz.</p>
    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        <a class="btn btn-primary" asp-controller="Hesap" asp-action="Giris">Giriş Yap</a>
        <a class="btn btn-outline-primary" asp-controller="Hesap" asp-action="Kayit">Hasta Kaydı</a>
    }
</div>

<h3>Kurumlar</h3>
<div class="row">
    @foreach (var kurum in Model)
    {
        <div class="col-md-6 mb-3">
            <div class="card">
                <div class="card-header"><b>@kurum.Ad</b> (@kurum.Tur)</div>
                <div class="card-body">
                    @foreach (var sube in kurum.Subeler)
                    {
                        <p class="mb-1"><b>@sube.Ad</b> - @sube.Adres</p>
                        <p class="text-muted small mb-1">Çalışma saatleri: @sube.AcilisSaati.ToString(@"hh\:mm") - @sube.KapanisSaati.ToString(@"hh\:mm") (Pazar kapalı)</p>
                        <ul>
                            @foreach (var bolum in sube.Bolumler)
                            {
                                <li>@bolum.Ad (@bolum.Hizmetler.Count hizmet)</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <p>Deneme hesabı: <code>admin</code> / <code>admin123</code></p>
}
